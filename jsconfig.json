{
  // The base is generated by `wxt prepare`, which runs automatically from the
  // postinstall script. It carries the `~/`/`@@/` path aliases and WXT's ambient
  // types (`#imports`, auto-imports, `import.meta.env`). Nothing in `.wxt/` is
  // committed, so this file stays the only checked-in config.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // Contributors write plain JavaScript. Every .js file is parsed, so syntax
    // errors and unresolvable module specifiers still show up in an editor, but
    // only files that opt in with a leading `// @ts-check` are type-checked.
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    // Where types matter they are written in JSDoc. Requiring an annotation on
    // every callback parameter would drag TypeScript into the contributor's
    // view of the project, which is exactly what this setup avoids.
    "noImplicitAny": false
  }
}
